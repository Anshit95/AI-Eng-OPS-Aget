# NexaTech AI Engineering Operations Agent Environment Configuration

# Project & Runtime
PROJECT_NAME="AI Engineering Operations Agent"
ENVIRONMENT="development"
DEBUG="True"

# Database Configuration
# Default: Local SQLite database for zero-dependency local execution
DATABASE_URL="sqlite:///./data/ops_agent.db"
# PostgreSQL Production Example (e.g. Google Cloud SQL / Docker):
# DATABASE_URL="postgresql+psycopg://postgres:your_secure_password@localhost:5432/ops_agent"

# Security & JWT Auth
# IMPORTANT: Generate a cryptographically secure random key in production
SECRET_KEY="replace-with-a-cryptographically-secure-random-32-byte-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# AI & Agent Orchestration (Google Gemini & Google ADK)
# Obtain your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# Simulator Settings
SIMULATOR_SEED="42"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]'
